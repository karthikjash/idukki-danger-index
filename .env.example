[TEMPLATE]
# Copy to `.env` and fill in. `.env` is git-ignored (see .gitignore).
#
# OpenWeatherMap API key (free tier is enough):
#   - current weather endpoint (conditions every ~10 min) becomes the PRIMARY
#     live provider when this is set
#   - its 5-day/3-hour forecast feeds the rainfall-outlook chart
#   Register at https://home.openweathermap.org/users/sign_up
OPENWEATHERMAP_API_KEY=

# --- SMS alerts (optional) -------------------------------------------------
# Without any key below the app runs in DEMO mode: every "sent" SMS is
# recorded to data/notifications/outbox.jsonl and previewed in the UI so the
# whole subscription flow works before a gateway is connected.
#
# Option A — Twilio (any country, full Unicode/Malayalam support):
#   https://www.twilio.com/docs/sms/quickstart
#   TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   TWILIO_AUTH_TOKEN=your_auth_token
#   TWILIO_FROM=+1xxxxxxx        # your Twilio number (E.164)
#
# Option B — Fast2SMS (Indian gateway; register a DLT sender + template for
#   transactional SMS, then transactional route dlt is required by TRAI):
#   FAST2SMS_API_KEY=your_api_key_here
